.env
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# downloaded by `lobes install`, never committed
bin/
models/
*.gguf

# per-task traces
runs/

# llama-server output, written by `lobes serve` and by eval/pod.sh
serve.log
serve.err.log
serve-*.log
eval-*.log

# the goal prompt driving the build, not part of the project
.goal.md

# eval sources, 70 MB, fetched by `lobes eval`
eval/data/

# per-item eval records; `lobes eval --report` computes the tables from them, the files ship as a release asset
eval/results/

# the pre-registrations and the run-by-run report of the v1 to v4 rounds; kept locally, not published
eval/PREREG*.md
eval/REPORT.md
docs/img/*.png
